NODE_ENV=production
PORT=10000

# Catálogo público opcional; vazio usa a API Node da própria aplicação.
# Para usar o serviço Go em produção: https://galeo-api-go.onrender.com
# Alterar esta variável exige executar npm run build novamente.
VITE_STORE_API_URL=

# MySQL Aiven — mesmo padrão do GBM Finance
DB_HOST=
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=galeo_store
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
# Certificado CA do serviço Aiven (PEM; permite \n literal). Obrigatório validar
# TLS antes de habilitar criptografia dos dados pessoais em produção.
DB_SSL_CA=

# Proteção adicional dos dados pessoais. Ative no Render somente após configurar
# a chave, TLS validado e backup. Não publique a chave nem reutilize SESSION_SECRET.
DATA_ENCRYPTION_ENABLED=false
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=primary

# Aplicação
APP_URL=https://galeo-store.onrender.com
ALLOWED_ORIGINS=https://galeo-store.onrender.com

# Sessão do administrador
SESSION_SECRET=
ADMIN_EMAIL=admin@galeostore.com.br
# Usada somente para criar o OWNER inicial se ADMIN_EMAIL ainda não existir.
# Mínimo de 10 caracteres; máximo de 72 bytes UTF-8 (acentos/emojis usam mais bytes).
ADMIN_PASSWORD=

# Armazenamento de mídia (Cloudinary)
# Configure no Render; não publique a chave secreta no GitHub.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Como o build usa Vite em produção no Render
NPM_CONFIG_INCLUDE=dev


# E-mail transacional (Resend)
# Cadastro e acesso de clientes exigem confirmação. Configure chave + domínio
# remetente verificado; sem envio disponível, cadastro retorna indisponível.
RESEND_API_KEY=
# Pendente: preencher apenas depois que os donos definirem o endereço e
# verificarem o domínio remetente no Resend. Não há remetente padrão.
EMAIL_FROM=
# Opcional: avisos de pedidos para a loja; sem valor, utiliza ADMIN_EMAIL.
STORE_NOTIFICATION_EMAIL=

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_POINT_TERMINAL_ID=

# Distribuidora
DISTRIBUTOR_WEBHOOK_SECRET=
