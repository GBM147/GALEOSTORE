{
  "name": "galeo-store",
  "private": true,
  "version": "0.2.0",
  "description": "GALEO Store — site e API de gestão integrada da loja.",
  "main": "server/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "check": "node --check server/index.js && node --check server/password-policy.js && node --check server/email-verification.js && node --check server/transactional-email.js && node --check server/data-protection.js && node --check server/database-privacy.js && node --check server/protected-session-store.js && node --check server/mysql-security-status.js && node --check server/test-data-cleanup.js && node --check scripts/cleanup-test-data.mjs && node --check server/mercado-pago.js && node --check server/media-library.js && node --check session-policy.js",
    "test": "node --test --test-isolation=none server/media-library.test.js server/data-protection.test.js server/database-privacy.test.js server/transactional-email.test.js",
    "test:integration": "node --test --test-isolation=none tests/backend.integration.test.js tests/mercado-pago.integration.test.js",
    "test:security": "node --test --test-isolation=none tests/auth-security.integration.test.js",
    "test:email": "node --test --test-concurrency=1 tests/email-verification.integration.test.js tests/resend-events.integration.test.js",
    "test:privacy": "node --test --test-isolation=none tests/database-privacy.integration.test.js",
    "test:cleanup": "node --test --test-concurrency=1 tests/test-data-cleanup.integration.test.js",
    "cleanup:test-data": "node scripts/cleanup-test-data.mjs",
    "test:browser": "node --test --test-isolation=none tests/frontend.browser.mjs"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.18.1",
    "helmet": "^8.3.0",
    "mysql2": "^3.14.3",
    "node-cron": "^4.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4",
    "cloudinary": "^2.7.0",
    "multer": "^2.0.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.1.9"
  }
}
